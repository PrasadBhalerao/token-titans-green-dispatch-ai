        emissions["Emissions Calculator<br/>src/core/emissions.py"]
        metrics["Metrics Calculator<br/>src/core/metrics.py"]
        constraints["Constraint Validator<br/>src/core/constraints.py"]
        planStore["Plan Store<br/>src/core/plan_store.py"]
        scenarioStore["Scenario Store<br/>src/core/scenario_store.py"]
    end

